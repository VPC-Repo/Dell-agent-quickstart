# install.sh writes the real .env with random local credentials (python3 deploy/configure.py).
BUILDER_API_TOKEN=
POSTGRES_PASSWORD=
BUILDER_PORT=8766
# off: no sign-in, the UI listens on 127.0.0.1 only (reach it through an SSH tunnel).
# token: require BUILDER_API_TOKEN; set this before binding the port beyond loopback (BUILDER_BIND).
BUILDER_AUTH=off
LANGSMITH_TRACING=false
