{
  "name": "dell-agent-quickstart-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:demo": "node --experimental-strip-types --test tests/demoModel.test.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/*.mjs\" package.json tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "3.6.2",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  }
}
